#!/usr/bin/env bash
#
# GDB Dojo command line helper.
#
# Every listing is derived from the filesystem: an exercise is any directory
# under levels/ containing a `meta` file. Adding an exercise requires no edits
# to this script.

set -euo pipefail

# Where the learner invoked us from, captured before we move to the repo root.
# `dojo hint` needs it to tell which exercise directory they are standing in.
invocation_dir="$(pwd)"

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_dir"

# shellcheck source=lib/dojo-ui.sh
. "$repo_dir/lib/dojo-ui.sh"
# shellcheck source=lib/dojo-paths.sh
. "$repo_dir/lib/dojo-paths.sh"
# shellcheck source=lib/dojo-state.sh
. "$repo_dir/lib/dojo-state.sh"
# shellcheck source=lib/dojo-progress.sh
. "$repo_dir/lib/dojo-progress.sh"
# shellcheck source=lib/dojo-hints.sh
. "$repo_dir/lib/dojo-hints.sh"

total_count() { dojo_exercises "$repo_dir" | wc -l | tr -d '[:space:]'; }
done_count()  { dojo_exercises "$repo_dir" | dojo_progress_count "$repo_dir"; }

print_progress_line() {
    _d="$(done_count)"; _t="$(total_count)"
    _width=24
    _filled=0
    [ "$_t" -gt 0 ] && _filled=$(( _d * _width / _t ))
    printf '%bProgress%b  [%b%s%b%s] %s of %s\n' \
        "$BOLD" "$RESET" \
        "$GREEN" "$(printf '%*s' "$_filled" '' | tr ' ' '#')" "$RESET" \
        "$(printf '%*s' "$((_width - _filled))" '' | tr ' ' '.')" \
        "$_d" "$_t"
}

# Resolve the exercise the learner is currently standing in, if any.
# Returns non-zero when the caller is not inside one.
current_exercise() {
    _cwd="$invocation_dir"
    _rel="${_cwd#"$repo_dir"/}"
    if [ "$_rel" != "$_cwd" ] && [ -f "$repo_dir/$_rel/meta" ]; then
        printf '%s' "$_rel"
        return 0
    fi
    return 1
}

cmd_help() {
    dojo_clear
    dojo_header "GDB DOJO" "Practical GDB training"
    echo
    print_progress_line
    echo

    dojo_section "Commands"
    {
        printf 'dojo next\tshow the next unfinished exercise\n'
        printf 'dojo list\tevery exercise with completion state\n'
        printf 'dojo tracks\ttracks and how far along each one is\n'
        printf 'dojo paths\tbare exercise paths\n'
        printf 'dojo show <name>\tdetails for one exercise\n'
        printf 'dojo hint\treveal the next hint for the current exercise\n'
        printf 'dojo cheatsheet\tGDB commands you have unlocked so far\n'
        printf 'dojo doctor\tcheck that the toolchain works\n'
        printf 'dojo help\tthis message\n'
    } | dojo_table
    echo

    dojo_section "Typical flow"
    dojo_cmd "dojo next"
    dojo_cmd "cd <exercise directory>"
    dojo_cmd "start"
    dojo_cmd "make"
    dojo_cmd "./check.sh ANSWER"
}

cmd_tracks() {
    dojo_clear
    dojo_header "TRACKS"
    echo
    {
        printf 'Track\tExercises\tComplete\n'
        for track_dir in levels/*/; do
            track="$(basename "$track_dir")"
            list="$(dojo_exercises_in "$track" "$repo_dir")"
            if [ -z "$list" ]; then
                printf '%s\t0\t-\n' "$track"
            else
                n="$(printf '%s\n' "$list" | wc -l | tr -d '[:space:]')"
                d="$(printf '%s\n' "$list" | dojo_progress_count "$repo_dir")"
                printf '%s\t%s\t%s of %s\n' "$track" "$n" "$d" "$n"
            fi
        done
    } | dojo_table
    echo
    dojo_dim "Tracks with 0 exercises have no content yet."
}

cmd_list() {
    dojo_clear
    dojo_header "EXERCISES"
    echo
    {
        # Exercise numbers restart per level, so the level has to be shown
        # or "04" appears twice with different meanings.
        # Exercise numbers restart per level, so the level has to be shown or
        # "04" appears twice meaning different things. The path stays because
        # this is the listing people copy a `cd` out of; the skill text is one
        # `dojo show` away and would push the table past a usable width.
        printf 'Done\tLevel\tExercise\tPath\n'
        while IFS= read -r ex; do
            [ -n "$ex" ] || continue
            printf '%s\t%s\t%s\t%s\n' \
                "$(dojo_progress_mark_for "$ex" "$repo_dir")" \
                "$(dojo_meta "$ex" LEVEL "$repo_dir")" \
                "$(dojo_label "$ex" "$repo_dir")" \
                "$ex"
        done < <(dojo_exercises "$repo_dir")
    } | dojo_table
    echo
    print_progress_line
}

cmd_paths() {
    dojo_exercises "$repo_dir"
}

cmd_next() {
    dojo_clear
    next="$(dojo_progress_next "$repo_dir")"

    if [ -z "$next" ]; then
        dojo_header "ALL COMPLETE"
        echo
        dojo_success "Every exercise in the repository is finished."
        echo
        echo "Start over with:"
        dojo_cmd "make reset-progress"
        return 0
    fi

    dojo_header "NEXT EXERCISE" "$(dojo_meta "$next" LEVEL "$repo_dir") / $(dojo_label "$next" "$repo_dir")"
    echo
    printf 'Skill\n  %s\n\n' "$(dojo_meta "$next" SKILL "$repo_dir")"
    echo "Go there"
    dojo_cmd "cd $next"
    dojo_cmd "start"
    echo
    print_progress_line
}

cmd_show() {
    if [ "$#" -lt 1 ]; then
        dojo_error "Usage: dojo show <exercise-name>"
        return 1
    fi
    query="$1"
    match="$(dojo_exercises "$repo_dir" | grep -- "$query" || true)"

    if [ -z "$match" ]; then
        dojo_error "No exercise matches: $query"
        echo
        echo "See all of them with:"
        dojo_cmd "dojo list"
        return 1
    fi
    if [ "$(printf '%s\n' "$match" | wc -l | tr -d '[:space:]')" -gt 1 ]; then
        dojo_error "That matches more than one exercise:"
        printf '%s\n' "$match" | while IFS= read -r m; do dojo_cmd "$m"; done
        return 1
    fi

    status="not started"
    dojo_progress_done "$match" "$repo_dir" && status="complete"

    dojo_clear
    dojo_header "$(dojo_meta "$match" TRACK "$repo_dir" | tr '[:lower:]' '[:upper:]')" \
                "$(dojo_label "$match" "$repo_dir")"
    echo
    printf 'Skill\n  %s\n\n' "$(dojo_meta "$match" SKILL "$repo_dir")"
    printf 'Goal\n  %s\n\n' "$(dojo_meta "$match" GOAL "$repo_dir")"
    printf 'Status\n  %s\n\n' "$status"
    echo "Go there"
    dojo_cmd "cd $match"
    dojo_cmd "start"
}

cmd_hint() {
    # `|| true`: at the repo root current_exercise exits non-zero, and under
    # `set -e` a failing command substitution in an assignment aborts the
    # script, which made `dojo hint <name>` print nothing at all.
    ex="$(current_exercise || true)"
    if [ -z "$ex" ]; then
        ex="${1:-}"
        if [ -z "$ex" ]; then
            dojo_error "Run this from inside an exercise directory, or name one:"
            dojo_cmd "dojo hint 03-inspect"
            return 1
        fi
        ex="$(dojo_exercises "$repo_dir" | grep -- "$ex" | head -1)"
        [ -n "$ex" ] || { dojo_error "No exercise matches that name."; return 1; }
    fi

    total="$(dojo_hint_total "$ex" "$repo_dir")"
    if [ "$total" -eq 0 ]; then
        dojo_warn "This exercise has no hints yet."
        return 0
    fi

    dojo_hint_advance "$ex" "$repo_dir" >/dev/null

    dojo_clear
    dojo_header "HINT" "$(dojo_label "$ex" "$repo_dir")"
    echo
    printf 'Goal\n  %s\n\n' "$(dojo_meta "$ex" GOAL "$repo_dir")"
    dojo_hints_print "$ex" "$repo_dir"
    dojo_hints_footer "$ex" "$repo_dir"
}

cmd_cheatsheet() {
    dojo_clear
    dojo_header "CHEATSHEET" "Commands you have unlocked"
    echo

    # Built once into a variable: assigning inside a pipeline would run in a
    # subshell and the "nothing unlocked" flag would never survive.
    rows=""
    while IFS= read -r ex; do
        [ -n "$ex" ] || continue
        dojo_progress_done "$ex" "$repo_dir" || continue
        teaches="$(dojo_meta "$ex" TEACHES "$repo_dir")"
        [ -n "$teaches" ] || continue
        label="$(dojo_label "$ex" "$repo_dir")"
        while IFS= read -r t; do
            [ -n "$t" ] || continue
            rows="$rows${t%%:*}	${t#*:}	$label
"
        done <<EOF
$(printf '%s' "$teaches" | tr '|' '\n')
EOF
    done < <(dojo_exercises "$repo_dir")

    if [ -n "$rows" ]; then
        printf 'Command\tWhat it does\tFrom\n%b' "$rows" | dojo_table
    fi

    if [ -z "$rows" ]; then
        dojo_dim "Nothing unlocked yet. Finish an exercise and it shows up here."
    fi
    echo
    print_progress_line
}

cmd_doctor() {
    dojo_clear
    dojo_header "DOCTOR" "Toolchain check"
    echo

    rc=0
    check_tool() {
        if command -v "$1" >/dev/null 2>&1; then
            printf '  %bok%b    %-8s %s\n' "$GREEN" "$RESET" "$1" "$("$1" --version 2>&1 | head -1)"
        else
            printf '  %bmiss%b  %-8s %s\n' "$RED" "$RESET" "$1" "$2"
            rc=1
        fi
    }

    check_tool gcc  "install build-essential"
    check_tool make "install make"
    check_tool gdb  "install gdb, or use the Docker browser terminal"

    if command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 \
        || command -v openssl >/dev/null 2>&1; then
        printf '  %bok%b    %-8s %s\n' "$GREEN" "$RESET" "sha256" "answer checking available"
    else
        printf '  %bmiss%b  %-8s %s\n' "$RED" "$RESET" "sha256" "need sha256sum, shasum, or openssl"
        rc=1
    fi

    echo
    if [ "$rc" -eq 0 ]; then
        dojo_success "Everything needed is present."
    else
        dojo_warn "Something is missing. See docs/SETUP.md."
    fi
    return "$rc"
}

case "${1:-help}" in
    help | -h | --help) cmd_help ;;
    next)               cmd_next ;;
    list)               cmd_list ;;
    tracks)             cmd_tracks ;;
    paths)              cmd_paths ;;
    show)               shift; cmd_show "$@" ;;
    hint)               shift; cmd_hint "$@" ;;
    cheatsheet | cheat) cmd_cheatsheet ;;
    doctor)             cmd_doctor ;;
    *)
        dojo_error "Unknown command: $1"
        echo
        cmd_help
        exit 1
        ;;
esac
