# Exercise directories use an allowlist: only source and instruction files are
# tracked, so compiled binaries are ignored automatically and adding a new
# exercise never requires editing this file.
levels/**/*
!levels/**/
!levels/**/*.c
!levels/**/*.h
!levels/**/*.md
!levels/**/*.gdb
!levels/**/Makefile
!levels/**/meta
!levels/**/check.sh
!levels/**/start

# Build outputs
*.o
*.obj
*.exe
*.out
*.a
*.so
*.dll
*.dylib
playground/hello

# Debug and crash artifacts
core
core.*
*.core
*.dSYM/
.dojo/

# CMake and Make build directories
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json

# Editor and OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
